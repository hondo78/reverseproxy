# Server: {{ hostname }}{% if entries %} ({{ entries | length }} route{{ 's' if entries | length > 1 else '' }}){% endif %}

{% if is_default %}
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;

    set $route_target "-";

    ssl_certificate {{ certs_dir }}/default.crt;
    ssl_certificate_key {{ certs_dir }}/default.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

{% for entry in entries %}
    location {{ entry.location }} {
        set $route_target "{{ entry.route.target_host }}:{{ entry.route.target_port }}";
        proxy_pass http://{{ entry.route.target_host }}:{{ entry.route.target_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

{% endfor %}
{% if not has_root_location %}
    location / {
        return 444;
    }
{% endif %}
}
{% elif ssl_cert %}
server {
    listen 80;
    server_name {{ hostname }};

    # Redirect HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ hostname }};

    ssl_certificate {{ certs_dir }}/{{ ssl_cert.common_name | replace("*", "_wildcard_") | replace("/", "_") }}.crt;
    ssl_certificate_key {{ certs_dir }}/{{ ssl_cert.common_name | replace("*", "_wildcard_") | replace("/", "_") }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

{% for entry in entries %}
    location {{ entry.location }} {
        set $route_target "{{ entry.route.target_host }}:{{ entry.route.target_port }}";
        proxy_pass http://{{ entry.route.target_host }}:{{ entry.route.target_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

{% endfor %}
}
{% else %}
server {
    listen 80;
    server_name {{ hostname }};

{% for entry in entries %}
    location {{ entry.location }} {
        set $route_target "{{ entry.route.target_host }}:{{ entry.route.target_port }}";
        proxy_pass http://{{ entry.route.target_host }}:{{ entry.route.target_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

{% endfor %}
}
{% endif %}
