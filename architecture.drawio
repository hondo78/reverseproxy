        <!-- Manager log -> Volume logs -->
        <mxCell id="c-mlog-vlog" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#a78bfa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="mgr-logfile" target="v-logs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Logs router reads proxy log -->
        <mxCell id="c-rlogs-nlog" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#a78bfa;strokeWidth=1;" edge="1" parent="1" source="r-logs" target="mgr-logfile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Volume DB -> SQLite -->
        <mxCell id="c-vdb-sqlite" style="rounded=1;strokeColor=#6366f1;strokeWidth=1;dashed=1;" edge="1" parent="1" source="v-db" target="sqlite">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Docker Socket -> Nginx reload -->
        <mxCell id="c-sock-nginx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=1;dashed=1;" edge="1" parent="1" source="docker-sock" target="nginx-core">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1235" y="585" />
              <mxPoint x="50" y="585" />
              <mxPoint x="50" y="323" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c-sock-nginx-l" value="nginx -s reload" style="edgeLabel;html=1;fontSize=9;fontColor=#ef4444;" connectable="0" vertex="1" parent="c-sock-nginx">
          <mxGeometry x="0.3" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Health Check -> Backends -->
        <mxCell id="c-health-be" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f59e0b;strokeWidth=1;dashed=1;" edge="1" parent="1" source="s-health" target="backends-box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1070" y="468" />
              <mxPoint x="1070" y="830" />
              <mxPoint x="290" y="830" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c-health-be-l" value="TCP/HTTP check" style="edgeLabel;html=1;fontSize=9;fontColor=#f59e0b;" connectable="0" vertex="1" parent="c-health-be">
          <mxGeometry x="0.5" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Middleware -> Manager Log File -->
        <mxCell id="c-mw-mlog" style="rounded=1;strokeColor=#a78bfa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="middleware" target="mgr-logfile">
