  <!-- ==================== PAGE 2: DATA FLOW ==================== -->
  <diagram id="dataflow" name="Data Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="df-title" value="Data Flow: Route Creation" style="text;html=1;fontSize=20;fontStyle=1;align=center;fillColor=none;strokeColor=none;fontColor=#e1e4eb;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Steps -->
        <mxCell id="df1" value="1&#xa;Admin creates&#xa;route in Web UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="140" height="65" as="geometry" />
        </mxCell>
        <mxCell id="df2" value="2&#xa;POST /api/routes&#xa;FastAPI saves to&#xa;SQLite DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="150" height="65" as="geometry" />
        </mxCell>
        <mxCell id="df3" value="3&#xa;Nginx Service renders&#xa;Jinja2 template to&#xa;route_N.conf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#0ea5e9;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="100" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="df4" value="4&#xa;Config written to&#xa;shared volume&#xa;nginx-config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d2d44;strokeColor=#f59e0b;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="100" width="150" height="65" as="geometry" />
        </mxCell>
        <mxCell id="df5" value="5&#xa;docker exec&#xa;nginx -t&#xa;(validate config)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1a1a;strokeColor=#ef4444;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="140" height="65" as="geometry" />
        </mxCell>
        <mxCell id="df6" value="6&#xa;docker exec&#xa;nginx -s reload&#xa;(apply changes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1a1a;strokeColor=#ef4444;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="240" width="140" height="65" as="geometry" />
        </mxCell>
        <mxCell id="df7" value="7&#xa;Nginx picks up&#xa;new route from&#xa;conf.d/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#0ea5e9;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="240" width="150" height="65" as="geometry" />
        </mxCell>
        <mxCell id="df8" value="8&#xa;Traffic to&#xa;match_pattern is&#xa;proxied to target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a1a;strokeColor=#22c55e;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="240" width="160" height="65" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="dfa1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366f1;strokeWidth=2;" edge="1" parent="1" source="df1" target="df2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dfa2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0ea5e9;strokeWidth=2;" edge="1" parent="1" source="df2" target="df3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dfa3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f59e0b;strokeWidth=2;" edge="1" parent="1" source="df3" target="df4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dfa4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=2;" edge="1" parent="1" source="df4" target="df5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dfa5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=2;" edge="1" parent="1" source="df5" target="df6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dfa6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0ea5e9;strokeWidth=2;" edge="1" parent="1" source="df6" target="df7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dfa7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#22c55e;strokeWidth=2;" edge="1" parent="1" source="df7" target="df8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SSL Flow -->
        <mxCell id="ssl-title" value="Data Flow: SSL Certificate Issuance" style="text;html=1;fontSize=20;fontStyle=1;align=center;fillColor=none;strokeColor=none;fontColor=#e1e4eb;" vertex="1" parent="1">
          <mxGeometry x="320" y="380" width="450" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ssl1" value="1&#xa;Init CA&#xa;(RSA 4096, self-signed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a1a;strokeColor=#22c55e;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="440" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ssl2" value="2&#xa;Issue Certificate&#xa;(RSA 2048, CA-signed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a1a;strokeColor=#22c55e;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="440" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ssl3" value="3&#xa;Cert + Key written&#xa;to certs-data volume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d2d44;strokeColor=#f59e0b;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="440" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ssl4" value="4&#xa;Assign cert to route&#xa;Enable SSL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="440" width="150" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ssl5" value="5&#xa;Nginx config&#xa;includes ssl_certificate&#xa;paths, reload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#0ea5e9;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1030" y="440" width="140" height="65" as="geometry" />
        </mxCell>

        <mxCell id="ssla1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#22c55e;strokeWidth=2;" edge="1" parent="1" source="ssl1" target="ssl2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ssla2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f59e0b;strokeWidth=2;" edge="1" parent="1" source="ssl2" target="ssl3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ssla3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366f1;strokeWidth=2;" edge="1" parent="1" source="ssl3" target="ssl4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ssla4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0ea5e9;strokeWidth=2;" edge="1" parent="1" source="ssl4" target="ssl5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Logging Flow -->
        <mxCell id="log-title" value="Data Flow: Access Logging" style="text;html=1;fontSize=20;fontStyle=1;align=center;fillColor=none;strokeColor=none;fontColor=#e1e4eb;" vertex="1" parent="1">
          <mxGeometry x="370" y="560" width="350" height="30" as="geometry" />
        </mxCell>

        <mxCell id="log1" value="Request hits&#xa;Nginx proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#0ea5e9;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="610" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="log2" value="JSON log line&#xa;written to&#xa;proxy-access.log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b2d5e;strokeColor=#a78bfa;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="610" width="145" height="50" as="geometry" />
        </mxCell>
        <mxCell id="log3" value="Shared log-data&#xa;volume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d2d44;strokeColor=#f59e0b;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="495" y="610" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="log4" value="Manager reads&#xa;new log lines&#xa;(tail approach)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="695" y="610" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="log5" value="/api/logs/proxy&#xa;with filters&#xa;Time|IP|Method|Path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b2d5e;strokeColor=#a78bfa;fontColor=#e1e4eb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="905" y="610" width="155" height="50" as="geometry" />
        </mxCell>

        <mxCell id="loga1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#a78bfa;strokeWidth=2;" edge="1" parent="1" source="log1" target="log2">
