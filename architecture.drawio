        <!-- Nginx log -> Volume logs -->
        <mxCell id="c-nlog-vlog" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#a78bfa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="nginx-log" target="v-logs">
          <mxGeometry relative="1" as="geometry" />
